# Copy to .env and put your own PostgreSQL password in. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/attentio
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/attentio_test
# Optional: the time zone the timetable is written in (IANA name). Default Asia/Kolkata.
# ATTENTIO_TIMEZONE=Asia/Kolkata
# The key the worker and the simulator send to the backend (X-Attentio-Key). Use a long random value, the same
# for the backend, the worker and the simulator, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave it empty and only an admin token can send records.
ATTENTIO_SERVICE_KEY=
# Optional: the password for the simulated demo accounts. Empty: python -m simulator seed makes one per run,
# prints it once and writes it to .spool/demo-credentials.txt.
ATTENTIO_DEMO_PASSWORD=

# ---- Hosted deployment (see docs/deploy.md); none of these is needed for a local setup ----
# DATABASE_URL may be the plain postgresql:// (or postgres://) string a provider such as Neon gives you,
# query parameters (?sslmode=require&channel_binding=require) included; it is pointed at psycopg 3 for you.
# Where `python -m backend` listens. Default 127.0.0.1 (this machine only). A host such as Render needs 0.0.0.0
# (it sets PORT itself; locally the port comes from backend.url in config/attentio.yaml).
# ATTENTIO_HOST=0.0.0.0
# PORT=8000
# Where the worker, dashboard and simulator find the backend, instead of backend.url in config/attentio.yaml,
# e.g. the deployed one: https://attentio-backend.onrender.com
# ATTENTIO_BACKEND_URL=
# Seconds the dashboard (default 10) and the worker (default 3) wait for the backend. A free host sleeps when
# idle and takes up to a minute to wake, so set about 75 for the dashboard; keep the worker's short (its spool retries).
# ATTENTIO_HTTP_TIMEOUT=

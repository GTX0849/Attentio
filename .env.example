# Copy to .env and put your own PostgreSQL password in. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/classpulse
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/classpulse_test
# Optional: the time zone the timetable is written in (IANA name). Default Asia/Kolkata.
# CLASSPULSE_TIMEZONE=Asia/Kolkata

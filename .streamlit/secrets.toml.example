# Streamlit Community Cloud: paste this, with your values, into the app's Advanced settings > Secrets.
# Locally, copy it to .streamlit/secrets.toml (git-ignored) only if you want the dashboard to read it
# from there; the usual local setup is .env and needs none of this. Never commit real values.

# Where the deployed backend is (no trailing path).
ATTENTIO_BACKEND_URL = "https://attentio-backend.onrender.com"
# Seconds to wait for the backend. Render's free tier takes up to about a minute to wake, so wait longer than that.
ATTENTIO_HTTP_TIMEOUT = "75"
